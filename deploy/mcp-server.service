# Servizio systemd per il server MCP (container LXC Proxmox + venv).
# Installazione:
#   cp deploy/mcp-server.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now mcp-server
# Vedi README.md, sezioni "Sicurezza" (utente "mcp") e "Variabili fisse" (/etc/mcp-server/mcp-server.env).

[Unit]
Description=Server MCP per OpenWebUI
After=network-online.target
Wants=network-online.target

[Service]
User=mcp
WorkingDirectory=/opt/mcp-server
# Impostazioni generali (copia di .env.example, sostituita a ogni aggiornamento).
EnvironmentFile=/opt/mcp-server/.env
# Variabili fisse (segreti, indirizzi, preferenze), fuori dal repository e leggibili solo da root:
# systemd le legge come root prima di passare all'utente mcp. Vengono dopo il .env, quindi hanno la
# precedenza (per systemd l'ultimo file vince). Il "-" rende il file facoltativo.
EnvironmentFile=-/etc/mcp-server/mcp-server.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
Environment=PATH=/opt/mcp-server/venv/bin:/home/mcp/.deno/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/mcp-server/venv/bin/python /opt/mcp-server/mcp_server.py
Restart=on-failure
RestartSec=5

# Hardening: il resto del sistema e' in sola lettura per il server e per i comandi dell'agente
NoNewPrivileges=yes
ProtectSystem=strict
# /mnt scrivibile: la cartella dei dati (DATA_DIR, nelle variabili fisse) puo' stare su un disco montato li'
ReadWritePaths=/mnt /home/mcp
PrivateTmp=yes
# Altri punti di montaggio invisibili al server (i comandi dell'agente, nella sandbox, vedono comunque
# solo il workspace). /mnt resta visibile perche' contiene il disco dei dati.
TemporaryFileSystem=/media:ro /srv:ro

[Install]
WantedBy=multi-user.target
