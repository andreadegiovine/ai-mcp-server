# =============================================================================
# Impostazioni GENERALI (valori predefiniti). Ad ogni aggiornamento questo file viene
# copiato sopra .env, quindi NON modificare .env.
# Segreti e valori personali vanno in /etc/mcp-server/mcp-server.env (variabili fisse,
# vedi README "Variabili fisse"): lì hanno sempre la precedenza su questo file.
# Le righe commentate sono esempi da ridefinire nel file delle variabili fisse.
# =============================================================================

# ---- Server ----
MCP_PORT=8000
# MCP_API_KEY=cambia-questa-chiave-lunga-e-casuale
# Domande con modulo interattivo se il client lo supporta, altrimenti domanda testuale in chat.
# Metti false se OpenWebUI ha problemi a collegarsi al server (torna alla modalita' stateless + JSON).
ENABLE_ELICITATION=true
TIMEZONE=Europe/Rome
# DISABLED_TOOLS=esegui_python,scarica_file

# ---- Terminale ----
# Sandbox bubblewrap: auto (se disponibile) | obbligatoria (senza sandbox niente terminale) | disattivata
TERMINAL_SANDBOX=auto

# ---- Link ai file del workspace (immagini e documenti visibili nella chat) ----
# Facoltativo, nelle variabili fisse: indirizzo del server nei link, solo se il browser non raggiunge
# quello usato dal client (es. OpenWebUI collegato con un nome interno di Docker)
# MCP_URL_PUBBLICO=http://192.168.1.11:8000
LINK_FILE_GIORNI=30

# ---- Lettura documenti (OCR con tesseract) ----
OCR_LINGUE=ita+eng
OCR_MAX_PAGINE=30

# ---- Web ----
WEB_ALLOW_PRIVATE_URLS=false
# METEO_DEFAULT_LOCALITA=Priolo Gargallo

# ---- Home Assistant ----
# HASS_URL=http://192.168.178.48:8123
# HASS_TOKEN=incolla-qui-il-long-lived-token
HASS_READ_ONLY=false
HASS_CONFIRM_DOMAINS=lock,alarm_control_panel
# HASS_CONFIRM_ENTITIES=cover.cancello*,switch.caldaia
# HASS_BLOCKED_ENTITIES=switch.server_*,camera.*

# ---- Echo (bridge vocale ai-echo-dot-bridge, da definire nelle variabili fisse) ----
# Obbligatorio per timer, sveglie e musica, che suonano sull'Echo; i processi lunghi avvisano a voce
# ECHO_BRIDGE_URL=http://192.168.178.30:8124
# ECHO_BRIDGE_TOKEN=api-token-del-bridge
# ECHO_BRIDGE_ECHO=            (vuoto = l'Echo che ha ricevuto l'ultima richiesta vocale)

# ---- Musica ----
# Secondi dopo i quali un brano che non parte viene saltato
MUSIC_START_TIMEOUT=45

# ---- Email (Gmail: serve una "password per le app") ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tuoindirizzo@gmail.com
# SMTP_PASSWORD=password-per-le-app
# Mittente delle email inviate dal server (nome visualizzato e indirizzo)
# SMTP_NOME=Assistente di casa
# SMTP_FROM=tuoindirizzo@gmail.com

# ---- WhatsApp (gateway OpenWA: https://github.com/rmyndharis/OpenWA) ----
# OPENWA_URL=http://192.168.178.50:2785
# OPENWA_API_KEY=chiave-di-openwa
# OPENWA_SESSION_ID=id-della-sessione

# ---- GitHub (da definire nelle variabili fisse) ----
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO_AUTORIZZATI=tuoutente/progetto,tuoutente/altro-*
# GITHUB_AUTORE_NOME=Assistente di casa

# ---- Google Calendar (scegline uno) ----
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/service_account.json
# GOOGLE_CALENDAR_IDS=tuoindirizzo@gmail.com
